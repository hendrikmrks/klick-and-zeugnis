{
  "name": "klick-and-zeugnis.de",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "node scripts/sync-prisma-collections.mjs && next dev",
    "build": "node scripts/sync-prisma-collections.mjs && prisma generate --schema=prisma/.schema.resolved.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node scripts/sync-prisma-collections.mjs && prisma db push --schema=prisma/.schema.resolved.prisma",
    "db:seed": "node scripts/sync-prisma-collections.mjs && prisma db seed",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:reseed": "node scripts/reseed.mjs",
    "db:reset": "docker compose down -v && docker compose up -d --build",
    "prisma:sync": "node scripts/sync-prisma-collections.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f app",
    "postinstall": "node scripts/sync-prisma-collections.mjs && prisma generate --schema=prisma/.schema.resolved.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "schema": "prisma/.schema.resolved.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "next": "15.4.1",
    "next-auth": "^4.24.11",
    "openai": "^5.10.1",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
