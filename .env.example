# =============================================================================
# Docker (vollständiger Stack: App + MongoDB)
# =============================================================================
# Für den kompletten Container-Betrieb: .env.docker.example nach .env kopieren
#   copy .env.docker.example .env
#
# DATABASE_URL wird im Docker-Compose-Stack automatisch gesetzt.
# Für lokale npm-Entwicklung mit Docker-MongoDB:
# DATABASE_URL=mongodb://localhost:27017/klick-and-zeugnis?directConnection=true

# Collection-Präfix trennt Umgebungen in derselben DB:
#   dev_   → lokale npm-Entwicklung
#   local_ → Docker-Stack (Standard in docker-compose)
#   prod_  → Produktion
MONGODB_COLLECTION_PREFIX=dev_

# =============================================================================
# NextAuth
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ersetze-mich-mit-einem-langen-zufaelligen-string"

# =============================================================================
# OpenAI (optional – ohne Key wird Mock-Text verwendet)
# =============================================================================
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4"
# OPENAI_USD_TO_EUR=0.92

# =============================================================================
# Prisma (Windows ARM64 lokal)
# =============================================================================
PRISMA_CLIENT_ENGINE_TYPE=binary

# =============================================================================
# Vercel / Atlas (optional, für Cloud-Deployment)
# =============================================================================
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/klick-and-zeugnis?retryWrites=true&w=majority"
#
# Production (Branch: main):
#   MONGODB_COLLECTION_PREFIX=prod_
#   NEXTAUTH_URL=https://deine-prod-domain.vercel.app
#
# Preview / Development (Branch: develop oder PRs):
#   MONGODB_COLLECTION_PREFIX=dev_
#   NEXTAUTH_URL=https://dein-preview.vercel.app
