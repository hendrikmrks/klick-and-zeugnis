# =============================================================================
# MongoDB Atlas (gleicher Cluster, gleiche Datenbank, getrennte Collections)
# =============================================================================
# Atlas Connection String – Datenbankname z. B. klick-and-zeugnis
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/klick-and-zeugnis?retryWrites=true&w=majority"

# Collection-Präfix trennt Dev- und Prod-Daten in derselben DB:
#   dev_  → dev_User, dev_Certificate, …
#   prod_ → prod_User, prod_Certificate, …
#   local_ → für Docker/lokale MongoDB
MONGODB_COLLECTION_PREFIX=dev_

# =============================================================================
# NextAuth
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ersetze-mich-mit-einem-langen-zufaelligen-string"

# =============================================================================
# OpenAI (optional – ohne Key wird Mock-Text verwendet)
# =============================================================================
OPENAI_API_KEY=""

# =============================================================================
# Prisma (Windows ARM64 lokal)
# =============================================================================
PRISMA_CLIENT_ENGINE_TYPE=binary

# =============================================================================
# Vercel (in Dashboard setzen, nicht in .env committen)
# =============================================================================
# Production (Branch: main):
#   MONGODB_COLLECTION_PREFIX=prod_
#   DATABASE_URL=<gleicher Atlas-String>
#   NEXTAUTH_URL=https://deine-prod-domain.vercel.app
#   NEXTAUTH_SECRET=<eigener Prod-Secret>
#
# Preview / Development (Branch: develop oder PRs):
#   MONGODB_COLLECTION_PREFIX=dev_
#   DATABASE_URL=<gleicher Atlas-String>
#   NEXTAUTH_URL=https://dein-preview.vercel.app
#   NEXTAUTH_SECRET=<eigener Dev-Secret>
