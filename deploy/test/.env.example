# GHCR Images (Owner/Repo anpassen)
GHCR_IMAGE_APP=ghcr.io/hendrikmrks/klick-and-zeugnis.de-app
GHCR_IMAGE_DB_INIT=ghcr.io/hendrikmrks/klick-and-zeugnis.de-db-init

# Wird beim Deploy von GitHub Actions gesetzt
IMAGE_TAG=test

# Pflicht
NEXTAUTH_SECRET=ersetze-mich-mit-einem-langen-zufaelligen-test-secret

# Optional
OPENAI_API_KEY=
RUN_DB_SEED=false
FORCE_SEED_RESET=false
